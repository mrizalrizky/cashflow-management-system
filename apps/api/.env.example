NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cashflow:cashflow_dev@localhost:5432/cashflow

# Kunci access token: minimal 32 karakter acak, mis. hasil `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
# Percobaan login per IP per menit.
LOGIN_RATE_LIMIT=5
# Jumlah reverse proxy di depan API (0 bila diakses langsung).
TRUST_PROXY_HOPS=0

# Alamat web lain yang boleh memanggil API dari browser, dipisah koma. Kosongkan bila web dan
# API disajikan dari alamat yang sama (bawaan dan yang dianjurkan).
CORS_ORIGINS=

# Folder berkas bukti transaksi. Cadangkan bersama database.
STORAGE_DIR=./storage
