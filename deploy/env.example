# Konfigurasi produksi. Salin menjadi deploy/.env (tidak pernah masuk repositori), lalu isi.
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env
# Yang bertanda WAJIB membuat aplikasi menolak dijalankan bila kosong.

# WAJIB. Alamat database PostgreSQL (Neon), lengkap dengan sslmode=require.
DATABASE_URL=

# WAJIB. Kunci penanda tangan sesi login, minimal 32 karakter acak.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=

# WAJIB. Token Cloudflare Tunnel (dasbor Cloudflare: Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# Admin pertama. Dibuat sekali, hanya bila belum ada admin; passwordnya sementara dan wajib
# diganti saat login pertama.
SEED_ADMIN_NAME=Administrator
# WAJIB.
SEED_ADMIN_EMAIL=
# WAJIB, minimal 8 karakter.
SEED_ADMIN_PASSWORD=

# Percobaan login per alamat pengunjung per menit.
LOGIN_RATE_LIMIT=5

# WAJIB. Folder di server yang menerima cadangan, mis. /srv/backup/cashflow.
BACKUP_HOST_DIR=
# Jam cadangan harian (24 jam) menurut TZ, dan berapa hari cadangan disimpan (0 = selamanya).
BACKUP_AT=01:30
BACKUP_KEEP_DAYS=14

# Zona waktu container (jam cadangan dan catatan log).
TZ=Asia/Jakarta
