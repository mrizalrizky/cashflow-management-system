# Konfigurasi produksi. Salin menjadi deploy/.env (tidak pernah masuk repositori), lalu isi.
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env
# Yang bertanda WAJIB membuat aplikasi menolak dijalankan bila kosong.

# Nilai yang memuat tanda $ atau spasi harus diapit kutip tunggal: 'Rahasia$2026'.

# WAJIB. Alamat database PostgreSQL (Neon), lengkap dengan sslmode=require.
# Pakai alamat sambungan LANGSUNG (host tanpa "-pooler"), bukan yang "pooled": migrasi dan
# cadangan membutuhkannya.
DATABASE_URL=

# WAJIB. Kunci penanda tangan sesi login, minimal 32 karakter acak.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=

# WAJIB. Token Cloudflare Tunnel (dasbor Cloudflare: Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# Percobaan PIN per alamat pengunjung per menit (di atas jeda 15 menit setelah 5 PIN salah).
LOGIN_RATE_LIMIT=5

# Opsional. Kunci Claude untuk "Minta pendapat AI" di Wishlist (console.anthropic.com).
# Kosong: tombol itu menjawab bahwa penilaian AI belum diaktifkan. Hanya dipakai server.
ANTHROPIC_API_KEY=
# Penilaian AI yang berhasil per hari (waktu Jakarta).
AI_REVIEW_DAILY_LIMIT=20

# Diisi otomatis oleh deploy GitHub Actions (image dari ghcr.io, per digest). Biarkan kosong
# bila memasang dengan tangan: image dibangun di server.
API_IMAGE=
MIGRATE_IMAGE=
WEB_IMAGE=
BACKUP_IMAGE=

# WAJIB. Folder di server yang menerima cadangan, mis. /srv/backup/cashflow.
BACKUP_HOST_DIR=
# Jam cadangan harian (24 jam) menurut TZ, dan berapa hari cadangan disimpan (0 = selamanya).
BACKUP_AT=01:30
BACKUP_KEEP_DAYS=14

# Zona waktu container (jam cadangan dan catatan log).
TZ=Asia/Jakarta
